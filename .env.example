# 复制为 .env 后填入自己的密钥
# cp .env.example .env

# ================================
# Qdrant 向量数据库（获取 API 密钥：https://cloud.qdrant.io/）
# ================================
QDRANT_URL=https://<your-cluster>.cloud.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ================================
# Neo4j 图数据库（获取 API 密钥：https://neo4j.com/cloud/aura/）
# ================================
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=<your-username>
NEO4J_PASSWORD=<your-password>
NEO4J_DATABASE=<your-database>
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ================================
# 嵌入（Embedding）配置（阿里云百炼：https://dashscope.aliyun.com/）
# 若 EMBED_MODEL_TYPE 为空，dashscope 默认 text-embedding-v3；
# local 默认 sentence-transformers/all-MiniLM-L6-v2
# ================================
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=<your-embedding-api-key>
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ================================
# 对话模型（LLM）配置
# ================================
LLM_API_KEY=<your-llm-api-key>
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat
TAVILY_API_KEY=<your-tavily-api-key>

# 分块策略
SPLIT_STRATEGY=default

# ================================
# 重排（Rerank）配置
# ================================
RERANK_ENABLED=true
RERANKER_MODEL=qwen3-rerank
RERANK_API_KEY=<your-rerank-api-key>
RERANK_TIMEOUT=20

# ================================
# 评测模型（可选，缺省时回退到 LLM_* 配置）
# ================================
# EVAL_API_KEY=
# EVAL_BASE_URL=
# EVAL_MODEL=
